' @test valid
' @role demo
' @status stable
' @dialect pt-br-standard
' @covers Op.Receive, Mod.Timeout, Op.Think, Op.Execute, Op.Signal, Op.Each, Mod.From, Op.If, Op.Define, Op.Set
' @description Showcase: todas as construções estáveis v0.4
'
' ═══════════════════════════════════════
' Showcase: revisão de documento
' Demonstra expression grammar,
' stream MVP (SINAL), RECEBA com timeout,
' CADA com escopo aninhado.
' ═══════════════════════════════════════

PARTICIPANTES autor

FERRAMENTAS search

' --- RECEBA com MÁXIMO (timeout) ---

RECEBA document
MÁXIMO 3m
<<
Cole o texto do documento para revisão.
>>
FIM

' --- PENSE cria stream ~review ---

PENSE review
  OBJETIVO <<
  Revise o documento.
  >>
  ENTRADA <<
  $document
  >>
  RESULTADO
  * issues: LISTA - problemas encontrados
    * title: TEXTO - descrição
    * severity: NÚMERO - gravidade de 1 a 10
    * fixable: MARCADOR - corrigível automaticamente
  * score: NÚMERO - nota geral de 1 a 10
FIM

' --- EXECUTE + SINAL no stream ativo ---

EXECUTE refs
  COM !search
  - query: $document
FIM

ESPERE
  POR ?refs
FIM

SINAL ~review
  <<
  Fontes adicionais: $refs
  >>
FIM

ESPERE
  POR ?review
FIM

' --- Expression grammar: comparações, E, NÃO ---

DEFINA needs_attention
FALSO
FIM

SE $review.score < 5 E NÃO ($review.score = 1)
  ALTERE $needs_attention
  VERDADEIRO
  FIM
FIM

' --- CADA com escopo aninhado ---
' $issue, ?fix, $fix — invisíveis fora do loop

CADA $issue DE $review.issues

  SE ($issue.severity >= 7 E $issue.fixable = VERDADEIRO) OU $issue.severity >= 9
    PENSE fix
      OBJETIVO <<
      Sugira uma correção.
      >>
      ENTRADA <<
      Problema: $issue.title
      >>
      RESULTADO
      * suggestion: TEXTO - sugestão
    FIM

    ESPERE
      POR ?fix
    FIM

    ESCREVA
      PARA @autor
      <<
      Problema: $issue.title
      Correção: $fix.suggestion
      >>
    FIM
  FIM

FIM

' --- Resumo ---

SE $needs_attention = VERDADEIRO
  ESCREVA
    PARA @autor
    <<
    O documento precisa de atenção. Nota: $review.score
    >>
  FIM
FIM

ENCERRE
