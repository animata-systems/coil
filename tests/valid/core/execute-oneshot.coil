' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.Execute, Mod.Using, Op.Tools, Op.Wait
' @description One-shot tool execution with arguments

RECEIVE url
END

TOOLS load_article

EXECUTE article
  USING !load_article
  - url: $url
  - format: "markdown"
END

WAIT
  ON ?article
END

EXIT
