' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.Send, Mod.Await, Pol.All, Mod.For
' @description SEND with AWAIT ALL — wait for all recipients to reply

ACTORS reviewer_a, reviewer_b

SEND review_request
  FOR @reviewer_a, @reviewer_b
  AWAIT ALL
  TIMEOUT 30m
  <<
  Please review the attached document.
  >>
END

WAIT
  ON ?review_request
END

EXIT
