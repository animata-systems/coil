' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.Wait, Mod.On, Pol.Any
' @description WAIT bound form: bind resolved value to $data

THINK plan
  GOAL <<
  Create a plan.
  >>
  RESULT
  * steps: TEXT - plan steps
END

THINK review
  GOAL <<
  Review the plan.
  >>
  RESULT
  * verdict: TEXT - review verdict
END

WAIT data
  ON ?plan, ?review
  MODE ANY
END

EXIT
