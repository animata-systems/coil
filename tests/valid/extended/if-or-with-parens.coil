' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.If
' @description IF with mixed AND/OR requires parentheses

DEFINE priority
"low"
END

DEFINE score
5
END

DEFINE override
FALSE
END

IF ($score > 8 AND $priority = "high") OR $override = TRUE
  THINK escalate
    GOAL <<
    Escalate to manager.
    >>
  END

  WAIT
    ON ?escalate
  END
END

EXIT
