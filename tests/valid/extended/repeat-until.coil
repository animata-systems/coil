' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.Repeat, Mod.Until, Mod.Limit, Op.Set
' @description REPEAT with condition and mandatory upper limit

DEFINE done
FALSE
END

REPEAT UNTIL $done = TRUE NO MORE THAN 3

  THINK check
    GOAL <<
    Check if the task is complete.
    >>
    RESULT
    * complete: FLAG - is the task done
  END

  WAIT
    ON ?check
  END

  IF $check.complete = TRUE
    SET $done
    TRUE
    END
  END

END

EXIT
