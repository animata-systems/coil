' @test valid
' @role test
' @status stable
' @dialect en-standard
' @covers Op.Signal, Op.Think, Op.Execute, Op.Tools
' @description SIGNAL sends data into an active stream

RECEIVE query
END

TOOLS search

THINK analysis
  GOAL <<
  Analyze the topic using all available data.
  >>
  RESULT
  * answer: TEXT
END

EXECUTE results
  USING !search
  - query: $query
END

WAIT
  ON ?results
END

SIGNAL ~analysis
  <<
  Additional search results: $results
  >>
END

WAIT
  ON ?analysis
END

EXIT
